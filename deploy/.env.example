# Settings for docker-compose.yml. install.sh copies this to .env and fills it in.

# Your time zone, for scheduled jobs and backups (e.g. Europe/Athens)
TZ=UTC
# The user and group that own ./pb_data (run `id` to see yours)
PUID=1000
PGID=1000
# The port on this machine (localhost only)
PORT=8090
# Who push services can contact about this server: mailto:you@example.com
# (defaults to the owner's email)
TROYE_PUSH_CONTACT=

# Waking the GPU PC that analyses photos (docs/deploy.md, "Waking the PC"):
# its MAC address, and your network's broadcast address with port 9. The packet
# only reaches the home network with the app on the host network:
#COMPOSE_FILE=docker-compose.yml:docker-compose.host.yml
TROYE_WAKE_MAC=
TROYE_WAKE_ADDR=255.255.255.255:9

# Remote access with Tailscale. Uncomment COMPOSE_FILE and add an auth key from
# https://login.tailscale.com/admin/settings/keys (only needed for the first start).
#COMPOSE_FILE=docker-compose.yml:docker-compose.tailscale.yml
TS_AUTHKEY=
TS_HOSTNAME=troye

# A worker next to the app. Create the worker account in the admin UI
# (/_/, the workers collection), then uncomment COMPOSE_PROFILES.
#COMPOSE_PROFILES=worker
TROYE_WORKER=
TROYE_WORKER_PASSWORD=
# Which file in workers/ it runs
TROYE_WORKER_SCRIPT=worker.py

# Pin a version instead of the latest build:
#TROYE_IMAGE=ghcr.io/kalfasyan/troye:v1.0.0
#TROYE_WORKER_IMAGE=ghcr.io/kalfasyan/troye-worker:v1.0.0
